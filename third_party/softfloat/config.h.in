#ifndef LIBX87_SOFTFLOAT_CONFIG_INCLUDED
#define LIBX87_SOFTFLOAT_CONFIG_INCLUDED

#include <stdint.h>

#cmakedefine01 LIBX87_SOFTFLOAT_BIG_ENDIAN
#if !LIBX87_SOFTFLOAT_BIG_ENDIAN
#define BX_LITTLE_ENDIAN 1
#endif

#cmakedefine01 LIBX87_SOFTFLOAT_BUILTIN_CLZ
#define BX_HAVE___BUILTIN_CLZ LIBX87_SOFTFLOAT_BUILTIN_CLZ
#define BX_HAVE_INT128 0
#define BX_CPP_INLINE inline
#define BX_CONST64(value) UINT64_C(value)

typedef uint8_t Bit8u;
typedef int8_t Bit8s;
typedef uint16_t Bit16u;
typedef int16_t Bit16s;
typedef uint32_t Bit32u;
typedef int32_t Bit32s;
typedef uint64_t Bit64u;
typedef int64_t Bit64s;

#endif
